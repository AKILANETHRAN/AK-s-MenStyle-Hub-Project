# Copy these entries into Render > backend service > Environment.
# Replace placeholders with credentials in Render; keep secrets out of Git.
# Email over HTTPS (works without SMTP ports).
EMAIL_PROVIDER=resend
EMAIL_ENABLED=true
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=orders@YOUR_VERIFIED_DOMAIN
EMAIL_FROM_NAME=AK'S MEN STYLE

# WhatsApp development setup: only your verified Meta test recipient.
META_WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token
META_WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
META_WHATSAPP_API_VERSION=replace_with_version_from_meta_api_setup
META_WHATSAPP_TEST_MODE=true
META_WHATSAPP_TEST_RECIPIENT=91YOUR_VERIFIED_TEST_NUMBER
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
