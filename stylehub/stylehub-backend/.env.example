PORT=5000
# Optional Docker override; leave unset for local SQLite at config/stylehub.sqlite.
# STYLEHUB_DB_PATH=/app/data/stylehub.sqlite
JWT_SECRET=replace_with_secure_secret
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=stylehub
MONGODB_SYNC_INTERVAL_MS=30000
VTON_SERVICE_URL=http://127.0.0.1:7860
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Nodemailer / SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akmensstylehub@gmail.com
SMTP_PASS=
EMAIL_FROM=akmensstylehub@gmail.com
EMAIL_FROM_NAME=AK'S MEN STYLE

# Meta WhatsApp Cloud API
# Copy these values from Meta for Developers > WhatsApp > API Setup.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=
# Set this to an approved utility template for production. Use hello_world for Meta test-number setup.
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Development-only alerts. They always target one approved Meta test recipient.
META_WHATSAPP_TEST_MODE=false
META_WHATSAPP_TEST_RECIPIENT=
